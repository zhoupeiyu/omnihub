FROM omnihub-media-worker:local
USER root
RUN apt-get update && apt-get install -y --no-install-recommends python3-venv python3-dev gcc pkg-config libavformat-dev libavcodec-dev libavdevice-dev libavutil-dev libavfilter-dev libswscale-dev libswresample-dev && rm -rf /var/lib/apt/lists/* && /usr/bin/python3 -m venv /opt/auto-editor && /opt/auto-editor/bin/pip install --no-cache-dir 'Cython<3' wheel 'numpy<2' && /opt/auto-editor/bin/pip install --no-cache-dir --no-build-isolation av==10.0.0 pillow==10.0.0 && /opt/auto-editor/bin/pip install --no-cache-dir --no-deps auto-editor==23.32.1 && ln -s /opt/auto-editor/bin/auto-editor /usr/local/bin/auto-editor
COPY app.py /app/app.py
USER 10001:10001
