# Hosted Sign in with ChatGPT; all fields are supplied through the service environment.
# Request approval for BOTH identity and ChatGPT plan usage before enabling.
# https://developers.openai.com/siwc/request-client-id
OMNIHUB_OPENAI_PLAN_USAGE_APPROVED=false
OMNIHUB_OPENAI_CLIENT_ID=
OMNIHUB_OPENAI_REDIRECT_URI=https://omnihub.noxhub.org/api/ai/oauth/openai/callback

# Use the exact token authentication method provisioned by OpenAI:
# none, or client_secret_basic (requires a server-side client secret).
OMNIHUB_OPENAI_TOKEN_AUTH_METHOD=
OMNIHUB_OPENAI_CLIENT_SECRET=

# A separately generated 32-byte key encoded as 64 hex characters.
# Store in the server secret manager; never commit its value.
# Rotation requires users to authorize again; keep it with encrypted DB backups.
OMNIHUB_AI_OAUTH_KEY=

# Before enabling: register the exact HTTPS callback above, confirm the granted
# Responses API scopes, and redact callback query strings in reverse-proxy logs.
# Verify real login, denial, renewal, model listing, and a user-approved AI test.
# Local protocol fixtures do not establish partner approval or live connectivity.
